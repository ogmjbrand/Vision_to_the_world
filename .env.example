# Supabase (auth, database)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role secret (Project Settings -> API). Server-only — never expose
# to the browser. Powers the trip-reminder cron, newsletter sends, and the
# email_logs audit trail. See docs/EMAIL_SETUP.md.
SUPABASE_SERVICE_ROLE_KEY=

# Amadeus self-service API (flights + hotels) — https://developers.amadeus.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# "test" (default) uses test.api.amadeus.com; "production" uses api.amadeus.com
AMADEUS_ENV=test

# Booking.com Demand API (alternative hotel search, if Amadeus coverage is insufficient)
BOOKING_API_KEY=

# Stripe — redirect-based Checkout Sessions (server-only secret key)
STRIPE_SECRET_KEY=

# PayPal — Smart Buttons (publishable client ID, safe to expose to the browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Cash App — display-only cashtag shown at checkout (no API integration)
NEXT_PUBLIC_CASHAPP_CASHTAG=

# Other payment gateways (not yet wired up)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Resend — transactional email (welcome, booking confirmation, invoice, trip
# reminder, newsletter, contact form). See docs/EMAIL_SETUP.md.
RESEND_API_KEY=
# Optional: "Name <you@yourdomain.com>". Defaults to the shared Resend
# sandbox sender (onboarding@resend.dev) until a sending domain is verified.
RESEND_FROM_EMAIL=
# Absolute site URL used for links inside emails.
NEXT_PUBLIC_SITE_URL=
# Authenticates Vercel Cron's daily call to /api/cron/trip-reminders. Any
# long random string.
CRON_SECRET=
# Signs one-click newsletter unsubscribe links. Optional — falls back to
# RESEND_API_KEY if unset; set an independent value in production.
UNSUBSCRIBE_SECRET=

# Analytics / marketing (all optional — features stay off until set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
